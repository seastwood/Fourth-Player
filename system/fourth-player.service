[Unit]
Description=Fourth Player -- browser guests join the game with real controllers
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
# ximagesrc needs the X cookie. A user service started by the graphical session
# usually inherits it, but "usually" is not good enough for the one thing that
# makes the whole program work.
Environment=XAUTHORITY=%h/.Xauthority
WorkingDirectory=%h/fourth-player
ExecStart=/usr/bin/python3 -m fourthplayer serve
Restart=on-failure
RestartSec=3

# The server needs three things from the system and nothing else: the X display
# to capture, /dev/uinput to create pads on, and the render node to encode with.
# Everything below removes something it has no business touching, so that a
# remote-code-execution bug in a program that listens on the internet has as
# little to work with as possible.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# The third path is not optional: the server writes a RetroArch autoconfig
# profile per pad when a session opens, and without it RetroArch guesses at the
# button layout -- which puts a guest's A button somewhere else entirely. Under
# ProtectHome=read-only that write fails silently, so this works by hand and
# breaks only under the service.
# %t is the user runtime directory, where the control socket is bound.
# ProtectSystem=strict makes it read-only otherwise, and the server dies at
# startup with "Read-only file system" from sock.bind -- which reads like a
# permissions bug in the program rather than a line missing from this file.
ReadWritePaths=%h/.local/state/fourth-player %h/.config/fourth-player %h/.config/retroarch %t
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DeviceAllow=/dev/uinput rw
DeviceAllow=/dev/dri rw
DeviceAllow=char-input r

[Install]
# Both, and deliberately.
#
# graphical-session.target is the right answer on a desktop, where the session
# manager activates it. This console has no desktop: Kodi is started from a
# script, nothing ever activates that target, and a service wanted only by it
# is never pulled in. It survived reboots by never being rebooted -- the first
# one showed it had not been starting on its own at all.
#
# default.target is what the user manager reaches on login, autologin
# included, so it covers this machine. Restart=on-failure covers the other
# half: if it starts before X is up the pipeline refuses and it tries again
# three seconds later, until the display is there.
WantedBy=default.target graphical-session.target
