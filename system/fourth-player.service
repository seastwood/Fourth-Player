[Unit]
Description=Fourth Player -- browser guests join the game with real controllers
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=PYTHONUNBUFFERED=1
# ximagesrc needs the X cookie. A user service started by the graphical session
# usually inherits it, but "usually" is not good enough for the one thing that
# makes the whole program work.
Environment=XAUTHORITY=%h/.Xauthority
WorkingDirectory=%h/fourth-player
ExecStart=/usr/bin/python3 -m fourthplayer serve
Restart=on-failure
RestartSec=3

# A ceiling, so that a leak in here costs this service and not the machine.
#
# Measured: idle with no session, about 40 MB; a capture running with no
# guests, about 87 MB. It has been seen at 15.3 GB, and at that point the
# kernel's own OOM killer had already put the machine into swap so deep that
# sshd would accept a connection and then never answer it -- the television
# frozen, nothing reachable, and no way in short of the power button. Killing
# one service is a far better outcome than losing the machine, and the log
# says plainly which it was.
#
# MemoryHigh throttles first and MemoryMax is the hard stop. Both are enormous
# next to the numbers above, so nothing legitimate should ever reach them; a run
# that does is a bug, and it is supposed to be noticed.
#
# The gap between them used to be 500 MB, and on 2026-09-12 that gap was where
# the service spent twenty hours. A leak in the peer teardown took it to 1.8 GB
# -- above MemoryHigh, below MemoryMax -- and MemoryHigh does not kill, it
# throttles: the kernel held every thread in the cgroup in reclaim for 77% of
# the time and left the unit "active (running)" throughout. Nothing was killed,
# so nothing was restarted and nothing was logged. The picture froze every few
# seconds and guests typing the PIN were told the host did not answer, for the
# whole day, because a service too slow to answer is indistinguishable from a
# healthy one to everything except the people using it.
#
# Narrowing that window was tried first and does not work. With MemoryHigh at
# 1900M and MemoryMax at 2G the service simply ground away inside the 100 MB
# gap instead: memory.current sat at 1973 MiB, memory.events said "high 40272,
# max 0, oom_kill 0", full pressure was ~49%, and NRestarts stayed 0 while the
# picture stuttered for everybody. Measured 2026-09-12, an hour after the
# 500 MB version of the same mistake.
#
# The reason is that throttling is self-limiting: the closer the cgroup gets to
# MemoryMax the harder the kernel holds it back, so it approaches the ceiling
# asymptotically and never touches it. Any gap between high and max is
# somewhere a leak can live indefinitely, and the width of the gap only changes
# how long it takes to settle there. MemoryHigh cannot give the behaviour this
# service wants at any value.
#
# So there is deliberately no MemoryHigh. MemoryMax is the only limit, and it
# is a wall rather than a brake: allocation runs at full speed until it, then
# reclaim fails, the kernel kills the process, and Restart=on-failure has it
# back in three seconds with the journal saying plainly that it was killed for
# memory. Guests reconnect on their own tokens -- one was seen reclaiming its
# slot that way -- so three seconds of "reconnecting" that mends itself beats
# any length of a host that is alive and too slow to answer.
#
# The early warning is in the program: see _watch_memory in server.py, which
# says so at 600 MB and again whenever the kernel reports it has been stalled
# on memory at all.
MemoryMax=2G

# Two arenas, not forty-eight.
#
# glibc gives each thread that contends for the heap its own 64 MB arena, up
# to eight per core. This machine has six cores, so the ceiling is 48 arenas
# and 3 GB of address space that malloc may hold on to without ever returning
# it -- more than MemoryMax, so the service can be killed for memory without
# leaking a single object.
#
# That is what was happening. Measured 2026-09-12 with guests connected:
# 1.4 GB of anonymous memory sitting in twenty ~64 MB mappings, while live
# GstBuffers stayed flat at ~533, threads flat, file descriptors flat and no
# pipeline failing to reach NULL. Nothing was leaking; the heap simply grew a
# new arena per thread and kept the freed space. It never showed up in testing
# because a synthetic guest runs at 21-50 threads where a real session runs at
# 90-110, and the arenas only appear under that contention.
#
# Two arenas costs a little lock contention on a service that is not
# malloc-bound, and takes the ceiling from 3 GB to 128 MB.
Environment=MALLOC_ARENA_MAX=2

# A bigger share of the processor, but only when there is a fight for it.
#
# This is the one process on the machine whose lateness everybody sees. A game
# that stutters for 200ms is a game that stuttered; this stalling for 200ms
# freezes the picture, cuts the sound and drops the controller at the same
# moment, for every guest at once -- because all three ride the same process
# and the same transport, so when it is descheduled all three stop together.
#
# Measured on the console during a Proton game: a run queue of 6.8 on six
# cores, with the game at 139%, Steam's helpers at 27%, Kodi still up behind
# it at 24% and X at 22%. Nothing was lost and nothing was dropped -- the
# guest's browser reported zero of each through every freeze -- because
# nothing was sent to lose. The sender simply was not run.
#
# Weight rather than priority: it changes nothing while the machine is idle,
# and under contention it asks for twice the share of an ordinary task instead
# of taking a fixed slice. A user service cannot lower its own niceness
# without privileges, and would not want to -- starving the game to feed the
# stream of it is not an improvement.
CPUWeight=200

# The server needs three things from the system and nothing else: the X display
# to capture, /dev/uinput to create pads on, and the render node to encode with.
# Everything below removes something it has no business touching, so that a
# remote-code-execution bug in a program that listens on the internet has as
# little to work with as possible.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# The third path is not optional: the server writes a RetroArch autoconfig
# profile per pad when a session opens, and without it RetroArch guesses at the
# button layout -- which puts a guest's A button somewhere else entirely. Under
# ProtectHome=read-only that write fails silently, so this works by hand and
# breaks only under the service.
# %t is the user runtime directory, where the control socket is bound.
# ProtectSystem=strict makes it read-only otherwise, and the server dies at
# startup with "Read-only file system" from sock.bind -- which reads like a
# permissions bug in the program rather than a line missing from this file.
ReadWritePaths=%h/.local/state/fourth-player %h/.config/fourth-player %h/.config/retroarch %t
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
DeviceAllow=/dev/uinput rw
DeviceAllow=/dev/dri rw
DeviceAllow=char-input r

[Install]
# Both, and deliberately.
#
# graphical-session.target is the right answer on a desktop, where the session
# manager activates it. This console has no desktop: Kodi is started from a
# script, nothing ever activates that target, and a service wanted only by it
# is never pulled in. It survived reboots by never being rebooted -- the first
# one showed it had not been starting on its own at all.
#
# default.target is what the user manager reaches on login, autologin
# included, so it covers this machine. Restart=on-failure covers the other
# half: if it starts before X is up the pipeline refuses and it tries again
# three seconds later, until the display is there.
WantedBy=default.target graphical-session.target
