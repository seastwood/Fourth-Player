# Let the desktop user raise the GPU clocks for a session, and nothing else.
# Installed to /etc/sudoers.d/fourth-player with mode 0440.
%sudo ALL=(root) NOPASSWD: /usr/local/libexec/fourth-player-clocks auto, /usr/local/libexec/fourth-player-clocks high, /usr/local/libexec/fourth-player-clocks low
