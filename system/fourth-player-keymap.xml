<?xml version="1.0" encoding="UTF-8"?>
<!-- One combination, for the person in the room.

     Chat, at any time: to answer the card that appears when a guest says
     something, and to start a conversation when nobody has said anything yet.
     The card is a prompt, not the only way in.

     Ctrl+Shift+C, and the "why not a single key" is worth writing down. F8
     was the first choice and F8 is Kodi's screenshot key, so pressing it
     photographed the television instead. Kodi's own keymap claims nearly
     every unmodified letter and eight function keys; what it does not claim
     is ctrl+shift with c, j, q, u, w, y or z. That was read out of
     /usr/share/kodi/system/keymaps/keyboard.xml rather than assumed, and c is
     the one somebody will remember.

     Installed to ~/.kodi/userdata/keymaps/fourth-player.xml. Kodi merges every
     file in that directory, so this adds one combination and changes nothing
     else about anybody's remote. -->
<keymap>
  <global>
    <keyboard>
      <c mod="ctrl,shift">RunScript(script.fourthplayer,chat)</c>
    </keyboard>
  </global>
</keymap>
